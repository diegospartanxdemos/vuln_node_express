#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('nodeexpressvulny:server');
var https = require('https');
var fs = require('fs');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create server with transport security.
 *
 * Security hardening:
 * - Prefer HTTPS in production or when HTTPS_ENABLED=true
 * - Load TLS key/cert from TLS_KEY_PATH and TLS_CERT_PATH
 * - Fail fast in production if TLS material is missing to avoid plaintext transport
 * - Allow HTTP fallback only for local development
 */

const useHttps = process.env.HTTPS_ENABLED === 'true' || process.env.NODE_ENV === 'production';
let server;

if (useHttps) {
  const keyPath = process.env.TLS_KEY_PATH;
  const certPath = process.env.TLS_CERT_PATH;

  if (!keyPath || !certPath) {
    console.error('[SECURITY] TLS is required but TLS_KEY_PATH or TLS_CERT_PATH is not set.');
    console.error('Set TLS_KEY_PATH and TLS_CERT_PATH to valid file paths (PEM format).');
    process.exit(1);
  }

  try {
    const options = {
      key: fs.readFileSync(keyPath),
      cert: fs.readFileSync(certPath),
      // Strong defaults can be tuned further (ciphers, minVersion)
      minVersion: 'TLSv1.2'
    };
    server = https.createServer(options, app);
  } catch (e) {
    console.error('[SECURITY] Failed to load TLS key/cert:', e.message);
    process.exit(1);
  }
} else {
  console.warn('[SECURITY] HTTPS disabled. Starting HTTP server for local development only.');
  var http = require('http');
  server = http.createServer(app);
}

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind + (useHttps ? ' (HTTPS)' : ' (HTTP)'));
}

// Borrowed from https://medium.com/@becintec/building-graceful-node-applications-in-docker-4d2cd4d5d392
// The signals we want to handle
// NOTE: although it is tempting, the SIGKILL signal (9) cannot be intercepted and handled
var signals = {
  'SIGHUP': 1,
  'SIGINT': 2,
  'SIGTERM': 15
};
// Do any necessary shutdown logic for our application here
const shutdown = (signal, value) => {
  console.log("shutdown!");
  server.close(() => {
    console.log(`server stopped by ${signal} with value ${value}`);
    process.exit(128 + value);
  });
};
// Create a listener for each of the signals that we want to handle
Object.keys(signals).forEach((signal) => {
  process.on(signal, () => {
    console.log(`process received a ${signal} signal`);
    shutdown(signal, signals[signal]);
  });
});
